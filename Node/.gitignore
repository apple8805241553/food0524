#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

.vscode
.idea
package-lock.json
headers.json
simple.env
dev.env
my-room
tep/
public/img/
public/uploads/
firebase-service-account.json

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

